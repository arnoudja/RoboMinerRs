[Unit]
Description=RoboMiner Rust web host
Documentation=file:/opt/robominer/deploy/systemd/README.md
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=robominer
Group=robominer
WorkingDirectory=/opt/robominer
EnvironmentFile=-/etc/robominer/robominer.env
ExecStart=/opt/robominer/bin/robominer-web
# Fail the unit if loopback /health does not become ready (DB + migrations).
ExecStartPost=/opt/robominer/bin/robominer-wait-web-health
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/robominer
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
