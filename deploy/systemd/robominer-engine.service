[Unit]
Description=RoboMiner Rust rally daemon
Documentation=file:/opt/robominer/deploy/systemd/README.md
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=robominer
Group=robominer
WorkingDirectory=/opt/robominer
EnvironmentFile=-/etc/robominer/robominer.env
# Refuse to start when the schema is behind the embedded migrations.
ExecStartPre=/opt/robominer/bin/robominer-engine migrate status --check
ExecStart=/opt/robominer/bin/robominer-engine rally rallies --loop --sleep-seconds 5 --persist
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/robominer
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
