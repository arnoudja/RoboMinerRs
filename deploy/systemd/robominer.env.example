# Example systemd EnvironmentFile for env-first RoboMiner config.
# Install as /etc/robominer/robominer.env (mode 0640, owned by root:robominer),
# then point units at it with:
#   EnvironmentFile=-/etc/robominer/robominer.env
# Prefer this over /etc/robominer/robominer.conf when migrating Pi/systemd hosts.
# See deploy/systemd/README.md#env-first-migration and deploy/LEGACY-SUNSET.md.

# Database (either URL or leave unset and use --config / conf file)
ROBOMINER_DATABASE_URL=mysql://robominer:password@127.0.0.1:3306/RoboMiner
# ROBOMINER_DB_MAX_CONNECTIONS=10

# Web host
HOST=127.0.0.1
PORT=8080
# ROBOMINER_WEB_ROOT=/opt/robominer/static
ROBOMINER_SESSION_SECRET=replace-with-openssl-rand-hex-32
ROBOMINER_SECURE_COOKIES=1
ROBOMINER_ALLOW_SIGNUP=0
ROBOMINER_TRUST_PROXY=1
# ROBOMINER_SESSION_TTL_HOURS=720
